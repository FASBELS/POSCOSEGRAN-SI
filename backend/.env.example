# Copie a .env y complete. Nunca suba .env al repositorio.

POSCOSEGRAN_ENTORNO=local

# Conexiones. La credencial de aplicación no debe poder ejecutar DDL.
POSCOSEGRAN_BD_URL_APP=postgresql+psycopg://poscosegran_app:local_app_2026@127.0.0.1:55432/poscosegran
POSCOSEGRAN_BD_URL_MIGRACIONES=postgresql+psycopg://poscosegran_migraciones:local_migraciones_2026@127.0.0.1:55432/poscosegran

# Identidad. En local basta un secreto compartido; en producción, JWKS de Supabase Auth.
POSCOSEGRAN_JWT_MODO=SECRETO_COMPARTIDO
POSCOSEGRAN_JWT_ALGORITMOS=HS256
POSCOSEGRAN_JWT_SECRETO=genere_una_cadena_larga_y_aleatoria_de_al_menos_32_caracteres
POSCOSEGRAN_JWT_EMISOR=http://localhost:54321/auth/v1
POSCOSEGRAN_JWT_AUDIENCIA=authenticated
POSCOSEGRAN_JWT_MARGEN_RELOJ_SEGUNDOS=30
POSCOSEGRAN_AUTH_LOCAL_HABILITADA=true
POSCOSEGRAN_AUTH_LOCAL_PASSWORD=genere_una_contrasena_local_de_al_menos_12_caracteres

# Variante con proveedor real:
# POSCOSEGRAN_JWT_MODO=JWKS
# POSCOSEGRAN_JWT_ALGORITMOS=RS256,ES256
# POSCOSEGRAN_JWT_JWKS_URL=https://SU_PROYECTO.supabase.co/auth/v1/.well-known/jwks.json
# POSCOSEGRAN_JWT_EMISOR=https://SU_PROYECTO.supabase.co/auth/v1

# Superficie HTTP. Orígenes explícitos, nunca comodín.
POSCOSEGRAN_CORS_ORIGENES=http://localhost:5173,http://localhost:8443
POSCOSEGRAN_LIMITE_PETICIONES_POR_MINUTO=120
POSCOSEGRAN_LIMITE_PETICIONES_ESCRITURA_POR_MINUTO=30

# Solo para pruebas con base real:
# POSCOSEGRAN_BD_URL_PRUEBAS=postgresql+psycopg://poscosegran_migraciones:CAMBIAR@localhost:5432/poscosegran_pruebas
